<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="بخش مدیریت"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingBottom="16dp" />

        <Button
            android:id="@+id/btnAddMed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="➕ افزودن داروی جدید" />

        <Button
            android:id="@+id/btnDashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊 داشبورد و تاریخچه" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="داروها"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="16dp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:id="@+id/medList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تگ گزارش روزانه (مثلا روی یخچال): با اسکنش وضعیت امروز را می‌گوید"
            android:textSize="14sp"
            android:paddingTop="16dp" />

        <Button
            android:id="@+id/btnWriteReportTag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🏷 نوشتن تگ گزارش روزانه" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="پیام‌های صوتی عمومی (اگر برای دارویی صدای اختصاصی نباشد، این‌ها پخش می‌شوند)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingTop="24dp" />

        <LinearLayout
            android:id="@+id/genericAudioContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تنظیمات"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="پذیرش اسکن زودتر از موعد (دقیقه)"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/inputEarlyWindow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="فاصله تکرار آلارم تا اسکن شدن (دقیقه)"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/inputRepeatMin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تا چند دقیقه بعد از موعد، نوبت هنوز قابل خوردن است (بعدش «جامانده» حساب می‌شود)"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/inputLateWindow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <CheckBox
            android:id="@+id/checkSingleTap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ثبت با یک‌بار زدن (اسکن اول در وقت نوبت، همان لحظه «خورده شد» ثبت شود)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="حالت پیش‌فرض: بار اول که گوشی به جعبه زده می‌شود می‌گوید «وقتشه بخور»، بعد از خوردن با زدن دوباره (یا دکمه «خوردم») ثبت می‌شود."
            android:textColor="#757575"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ذخیره تنظیمات" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مجوزهای حیاتی (برای کار درست آلارم‌ها هر دو را فعال کن)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingTop="24dp" />

        <Button
            android:id="@+id/btnBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔋 خروج از بهینه‌سازی باتری" />

        <Button
            android:id="@+id/btnExactAlarm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏰ اجازه آلارم دقیق" />

        <Button
            android:id="@+id/btnFullScreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📲 اجازه نمایش یادآوری روی صفحه قفل" />

        <Button
            android:id="@+id/btnNotifSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔔 تنظیمات اعلان‌ها" />

        <Button
            android:id="@+id/btnTestVoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔊 آزمایش صدای گوینده" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F5F5F5"
            android:padding="12dp"
            android:textColor="#212121"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="پشتیبان‌گیری"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="24dp" />

        <Button
            android:id="@+id/btnBackup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📦 خروجی پشتیبان (دیتا + صداها)" />

        <Button
            android:id="@+id/btnRestore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="♻ بازیابی از فایل پشتیبان" />
    </LinearLayout>
</ScrollView>
